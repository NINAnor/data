---
import "../styles/app.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { assetPath } from "../lib/site";
import type { SiteContext } from "../types";

interface Props {
  title?: string;
  context: SiteContext;
  switchUrl: string;
  hidePageHeading?: boolean;
}

const { title, context, switchUrl, hidePageHeading = false } = Astro.props;
const { site, footer, ui } = context;
const base = import.meta.env.BASE_URL;
const homeUrl = getRelativeLocaleUrl(context.language, "");
const searchUrl = getRelativeLocaleUrl(context.language, "search/");
const aboutUrl = getRelativeLocaleUrl(context.language, "about/");
const currentLanguage = context.language === "no" ? "NO" : "EN";
const alternateLanguage = context.language === "no" ? "EN" : "NO";
const currentLanguageName = context.language === "no" ? "Norsk" : "English";
---

<!doctype html>
<html lang={site.language} data-theme="nina">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#163546" />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <title>{title || site.title}</title>
    <link rel="icon" type="image/svg+xml" href={assetPath("/assets/favicon.svg", base)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-base-200 font-sans text-base-content">
    <header class="border-b border-base-300 bg-base-100">
      <nav class="mx-auto flex min-h-20 max-w-screen-2xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:flex-nowrap sm:gap-6 sm:px-8 sm:py-0" aria-label={ui.main_navigation}>
        <a class="shrink-0" href={homeUrl} aria-label={`${site.title} ${ui.home}`}>
          <img class="h-auto w-36 sm:w-52" src={assetPath("/assets/logo.svg", base)} alt={`NINA — ${site.title}`} width="209" height="49" />
        </a>
        <div class="flex w-full flex-wrap items-center justify-end gap-2 sm:w-auto sm:flex-nowrap sm:gap-6">
          <a class="btn btn-accent btn-sm sm:btn-md" href={searchUrl}>{ui.explore_datasets}</a>
          <a class="btn btn-outline btn-sm sm:btn-md" href={aboutUrl}>{ui.about}</a>
          <a class="btn btn-outline btn-sm sm:btn-md" href="https://maps.nina.no" target="_blank" rel="noreferrer">{ui.nina_maps}</a>
          <details class="language-dropdown dropdown dropdown-end">
            <summary
              class="btn btn-outline btn-sm gap-1 normal-case sm:btn-md"
              aria-label={`${ui.language_selector}: ${currentLanguageName}`}
            >
              {currentLanguage}
              <svg aria-hidden="true" width="12" height="8" viewBox="0 0 12 8" fill="currentColor" class="ml-1 transition-transform duration-200">
                <path d="M6 7.4L0 1.4L1.4 0L6 4.6L10.6 0L12 1.4L6 7.4Z" />
              </svg>
            </summary>
            <ul class="menu dropdown-content z-50 mt-1 min-w-36 rounded-xs bg-base-100 p-1 shadow-lg">
              <li>
                <span class="rounded-xs px-3 py-2 text-sm font-semibold" aria-label={currentLanguageName} aria-current="true">{currentLanguage}</span>
              </li>
              <li>
                <a class="rounded-xs px-3 py-2 text-sm hover:bg-base-200" href={switchUrl} lang={context.language === "no" ? "en" : "nb"} aria-label={ui.switch_language}>
                  {alternateLanguage}
                </a>
              </li>
            </ul>
          </details>
        </div>
      </nav>
    </header>

    <main class="mx-auto min-h-[70vh] w-full max-w-screen-2xl flex-1 px-4 py-8 sm:px-8 sm:py-12">
      {!hidePageHeading && <h1 class="mb-6 text-3xl font-bold tracking-tight text-primary sm:text-4xl">{title || site.title}</h1>}
      <slot />
    </main>

    <footer class="bg-primary text-primary-content">
      <div class="mx-auto grid max-w-screen-2xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-8 sm:py-12">
        <div class="space-y-2">
          <p class="font-semibold">{footer.organization}</p>
          {footer.address.map((line) => <p class="text-sm">{line}</p>)}
        </div>
        <div class="space-y-5 sm:text-right">
          <div class="flex flex-col gap-2 text-sm sm:items-end">
            {footer.phone && <a class="w-fit underline-offset-4 hover:underline" href={footer.phone.href}>{footer.phone.label}</a>}
            {footer.email && <a class="w-fit underline-offset-4 hover:underline" href={footer.email.href}>{footer.email.label}</a>}
          </div>
          <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm sm:justify-end" aria-label={ui.footer_navigation}>
            {footer.links.map((link) => <a class="underline-offset-4 hover:underline" href={link.url}>{link.label}</a>)}
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>

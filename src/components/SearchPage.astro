---
import { getRelativeLocaleUrl } from "astro:i18n";
import SearchApp from "./SearchApp";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadDatasets, loadKeywords, loadRecords, summarizeRecord } from "../lib/catalogue";
import { getSiteContext } from "../lib/site";
import type { Language } from "../types";

interface Props {
  locale: Language;
}

const { locale } = Astro.props;
const alternateLocale: Language = locale === "en" ? "no" : "en";
const context = await getSiteContext(locale);
const [records, keywords, datasets] = await Promise.all([
  loadRecords(),
  loadKeywords(),
  loadDatasets(),
]);
const urls = Object.fromEntries(records.map((record) => {
  const summary = summarizeRecord(record);
  return [summary.identifier, getRelativeLocaleUrl(locale, `datasets/${summary.slug}/`)];
}));
const previewUrls = Object.fromEntries(datasets.map((dataset) => [dataset.identifier, dataset.preview]));
---

<SiteLayout title={context.ui.search_page_title} context={context} switchUrl={getRelativeLocaleUrl(alternateLocale, "search/")} hidePageHeading>
  <SearchApp client:load catalogueUrl={context.catalogue.url} collectionId={context.catalogue.collectionId} keywords={keywords} detailUrls={urls} previewUrls={previewUrls} ui={context.ui} />
</SiteLayout>

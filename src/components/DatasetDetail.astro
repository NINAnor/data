---
import ExtentMap from "./ExtentMap";
import { getRelativeLocaleUrl } from "astro:i18n";
import { localizeDataset } from "../lib/metadata";
import type { Dataset, SiteContext } from "../types";

interface Props {
  dataset: Dataset;
  context: SiteContext;
}

const { dataset: rawDataset, context } = Astro.props;
const { ui, language } = context;
const dataset = localizeDataset(rawDataset, language, ui);
const home = getRelativeLocaleUrl(language, "");
const keywordGroups = dataset.keyword_groups.filter((group) => group.kind === "keyword");
const themeGroups = dataset.keyword_groups.filter((group) => group.kind === "theme");
---

<div class="mb-6">
  <a class="link link-primary" href={home}>&larr; {ui.back_to_catalogue}</a>
</div>

<section class="card mb-8 border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body">
    <div class="badge badge-outline">{ui.dataset}</div>
    {dataset.abstract && <p class="max-w-4xl text-lg">{dataset.abstract}</p>}
    <p class="text-sm opacity-70">{ui.identifier}: <span class="font-mono">{dataset.identifier}</span></p>
  </div>
</section>

{keywordGroups.length > 0 && <section class="mb-8 rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
  <h2 class="mb-4 text-xl font-semibold">{ui.keywords}</h2>
  {keywordGroups.map((group) => <div class="mb-3 last:mb-0">
    {group.label && <h3 class="mb-2 text-sm font-medium opacity-70">{group.label}</h3>}
    <div class="flex flex-wrap">
      {group.values.map((keyword) => <span class="badge badge-primary badge-outline mb-2 mr-2 h-auto min-h-6 max-w-full whitespace-normal wrap-anywhere">{keyword}</span>)}
    </div>
  </div>)}
</section>}

{themeGroups.length > 0 && <section class="mb-8 rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
  <h2 class="mb-4 text-xl font-semibold">{ui.themes}</h2>
  {themeGroups.map((group) => <div class="mb-4 last:mb-0">
    <h3 class="mb-2 text-sm font-medium opacity-70">{group.label || ui.themes}</h3>
    <div class="flex flex-wrap">
      {group.values.map((theme) => <span class="badge badge-secondary badge-outline mb-2 mr-2 h-auto min-h-6 max-w-full whitespace-normal wrap-anywhere">{theme}</span>)}
    </div>
  </div>)}
</section>}

{dataset.extent && <section class="card mb-8 border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body">
    <h2 class="card-title text-primary">{ui.spatial_extent}</h2>
    <ExtentMap client:visible extent={dataset.extent} label={dataset.map_label} />
  </div>
</section>}

{dataset.contacts.length > 0 && <section class="mb-8" aria-labelledby="contacts-heading">
  <h2 id="contacts-heading" class="mb-4 text-2xl font-bold">{ui.contacts}</h2>
  <div class="grid gap-6 lg:grid-cols-2">
    {dataset.contacts.map((contact) => <article class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <p class="text-sm font-medium uppercase tracking-wide opacity-60">{contact.role}</p>
        <h3 class="card-title">{contact.name}</h3>
        {contact.organization && <p class="font-medium">{contact.organization}</p>}
        {contact.position && <p class="text-sm opacity-70">{contact.position}</p>}
        {contact.methods.length > 0 && <dl class="mt-2 space-y-2">
          {contact.methods.map((method) => <div class="grid grid-cols-[7rem_1fr] gap-3 text-sm">
            <dt class="opacity-70">{method.label}</dt>
            <dd class="break-all">{method.href
              ? <a class="link link-primary" href={method.href} target={method.href.startsWith("http") ? "_blank" : undefined} rel={method.href.startsWith("http") ? "noopener noreferrer" : undefined}>{method.value}</a>
              : method.value}</dd>
          </div>)}
        </dl>}
        {contact.address.length > 0 && <address class="mt-3 not-italic text-sm">
          {contact.address.map((item) => <div><span class="opacity-70">{item.label}:</span> {item.value}</div>)}
        </address>}
        {(contact.hours || contact.instructions) && <dl class="mt-3 space-y-2 border-t border-base-300 pt-3 text-sm">
          {contact.hours && <div><dt class="font-medium">{ui.hours_of_service}</dt><dd>{contact.hours}</dd></div>}
          {contact.instructions && <div><dt class="font-medium">{ui.contact_instructions}</dt><dd>{contact.instructions}</dd></div>}
        </dl>}
      </div>
    </article>)}
  </div>
</section>}

{dataset.resources.length > 0 && <section class="mb-8" aria-labelledby="resources-heading">
  <h2 id="resources-heading" class="mb-4 text-2xl font-bold">{ui.access_downloads}</h2>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
    {dataset.resources.map((resource) => <article class="card card-compact border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body p-4">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h3 class="card-title min-w-0 break-words text-base">{resource.name}</h3>
          {resource.function && <span class="badge badge-sm badge-outline">{resource.function}</span>}
        </div>
        {resource.description && <p class="text-xs opacity-80">{resource.description}</p>}
        {(resource.protocol || resource.relation || resource.format || resource.format_version || resource.channel) && <dl class="mt-1 grid gap-x-3 gap-y-1 text-xs sm:grid-cols-2">
          {resource.protocol && <div><dt class="opacity-60">{ui.protocol}</dt><dd>{resource.protocol}</dd></div>}
          {resource.relation && <div><dt class="opacity-60">{ui.relation}</dt><dd>{resource.relation}</dd></div>}
          {resource.format && <div><dt class="opacity-60">{ui.format}</dt><dd>{resource.format}</dd></div>}
          {resource.format_version && <div><dt class="opacity-60">{ui.format_version}</dt><dd>{resource.format_version}</dd></div>}
          {resource.channel && <div><dt class="opacity-60">{ui.channel}</dt><dd>{resource.channel}</dd></div>}
        </dl>}
        {resource.href && <a class="btn btn-primary btn-sm mt-1 self-start" href={resource.href} target="_blank" rel="noopener noreferrer">{resource.action}</a>}
        {!resource.href && resource.url && <p class="break-all text-xs">{resource.url}</p>}
      </div>
    </article>)}
  </div>
</section>}

{dataset.metadata_sections.length > 0 && <details class="mb-8 rounded-box border border-base-300 bg-base-100 shadow-sm">
  <summary class="cursor-pointer p-6 text-xl font-semibold">{ui.detailed_metadata}</summary>
  <div class="space-y-8 px-6 pb-6">
    {dataset.metadata_sections.map((section) => <section>
      <h2 class="mb-3 text-lg font-semibold text-primary">{section.title}</h2>
      <dl class="divide-y divide-base-300 rounded-box border border-base-300">
        {section.fields.map((field) => <div class="grid gap-1 px-4 py-3 sm:grid-cols-[minmax(12rem,1fr)_2fr] sm:gap-6">
          <dt class="text-sm font-medium opacity-70">{field.label}</dt>
          <dd class="min-w-0 break-words text-sm">
            {field.kind === "status" ? <span class="badge badge-success badge-outline">{field.value}</span>
              : field.is_url ? <a class="link link-primary" href={field.value} target="_blank" rel="noopener noreferrer">{field.value}</a>
                : field.value}
          </dd>
        </div>)}
      </dl>
    </section>)}
  </div>
</details>}
